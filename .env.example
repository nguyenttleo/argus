# ── Argus configuration (all optional) ───────────────────────────────────────
# Copy to .env and fill in what you have. With NOTHING set, Argus runs fully
# offline on its heuristic + signature + YARA engines; key-gated reputation
# providers simply report "unavailable".

# ── Reputation providers (URL + file hash) ──
# Google Safe Browsing v4 - https://developers.google.com/safe-browsing
GOOGLE_SAFE_BROWSING_API_KEY=
# VirusTotal v3 (hash-only lookups) - https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=
# abuse.ch Auth-Key (free) - powers URLhaus (URL) AND MalwareBazaar (file family) - https://auth.abuse.ch/
URLHAUS_AUTH_KEY=
# Optional: a separate abuse.ch key for MalwareBazaar (defaults to URLHAUS_AUTH_KEY)
ABUSE_CH_AUTH_KEY=
# PhishTank (reserved; provider slot)
PHISHTANK_API_KEY=
ARGUS_REPUTATION_TIMEOUT_MS=6000

# ── URL fetcher (SSRF-safe) ──
ARGUS_FETCH_TIMEOUT_MS=8000
ARGUS_MAX_FETCH_BYTES=2097152

# ── Optional Tartarus detonation (spec v3) ──
# e.g. http://localhost:8080  - only py/js payloads, only when opted in
TARTARUS_URL=

# ── API server ──
PORT=8089
HOST=127.0.0.1
ARGUS_DATA_DIR=.data
# ARGUS_DB_PATH=.data/argus.sqlite
ARGUS_MAX_UPLOAD_BYTES=33554432
# HMAC secret used to hash client IPs before storage (set a real secret in prod)
ARGUS_IP_HASH_SECRET=change-me-in-production
ARGUS_CORS_ORIGIN=http://localhost:3000
ARGUS_RATE_LIMIT_MAX=60
ARGUS_RATE_LIMIT_WINDOW_MS=60000
# In-memory full-scan result cache: identical requests within this window return instantly
ARGUS_SCAN_CACHE_TTL_MS=300000
# Default URL-scan behaviour when the request doesn't specify
ARGUS_URL_FETCH_DEFAULT=true
ARGUS_REPUTATION_DEFAULT=true

# ── Encrypted quarantine (opt-in; default is hash-only retention) ──
ARGUS_QUARANTINE=false
ARGUS_QUARANTINE_TTL_MS=86400000

# ── Web app (web/) ──
# Base URL of the Argus API the Next.js proxy routes forward to (server-side only)
ARGUS_API=http://127.0.0.1:8089

# ── Public single-container hosting (`npm start` / Docker) ──
# Hosts usually set PORT for the public web listener. The private API still uses
# ARGUS_API_PORT and is reached only by the Next.js proxy inside the container.
# PORT=3001
ARGUS_API_PORT=8089
# ARGUS_PUBLIC_URL=https://your-public-argus-host.example
